            "Testes específicos",
            "Inflamação",
            "Deformidades"
          ]
        },
        {
          "number": 5,
          "name": "Resumo & Assinar",
          "icon": "✅",
          "fields": [
            "Preview colorido",
            "Barra de progresso",
            "Validação final",
            "Assinatura digital (ClickSign)"
          ]
        }
      ],
      "features": [
        "Auto-save: A cada campo (< 0.5s)",
        "Validação: Campos obrigatórios, interações medicamentosas",
        "Progress bar: Percentual em tempo real",
        "PDF: Gerado automaticamente ao salvar",
        "Signature: ClickSign integrado",
        "Follow-up: Versão simplificada para retornos"
      ],
      "database": {
        "table": "patient_anamnesis",
        "fields": [
          "id",
          "clinic_id",
          "patient_id",
          "anamnesis_type (first_consultation|follow_up)",
          "consultation_date",
          "data_chief_complaint (JSON)",
          "data_history (JSON)",
          "data_habits (JSON)",
          "data_physical_exam (JSON)",
          "status (in_progress|completed|signed)",
          "created_by_user_id",
          "last_edited_by_user_id",
          "created_at",
          "updated_at",
          "completed_at"
        ],
        "indices": [
          "patient_anamnesis(patient_id, created_at DESC)",
          "patient_anamnesis(status)"
        ]
      },
      "critical_points": [
        "Data completeness: Campos obrigatórios não podem estar vazios",
        "Medication interactions: Alertar sobre conflitos",
        "Auto-save reliability: Recuperação automática se browser fecha",
        "Data security: HIPAA/LGPD compliant"
      ]
