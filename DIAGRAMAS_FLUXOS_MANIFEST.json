  "flows": [
    {
      "id": 1,
      "name": "Chamada de Paciente",
      "type": "Real-time",
      "duration": "< 1 segundo",
      "latency_target": "< 500ms",
      "critical_in": "Latência real-time e sincronização",
      "actors": [
        "Frontend (médico)",
        "API (FastAPI)",
        "Backend (validação)",
        "Database (PostgreSQL)",
        "WebSocket (broadcast)",
        "TV (waiting room)",
        "Admin Panel"
      ],
      "stages": 6,
      "key_metrics": {
        "click_to_api": "< 100ms",
        "validation_db": "< 200ms",
        "websocket_broadcast": "< 300ms",
        "dashboard_update": "< 500ms",
        "total": "< 1s"
      },
      "database": {
        "table": "clinic_queue",
        "fields": [
          "id",
          "clinic_id",
          "appointment_id",
          "patient_id",
          "room",
          "called_at",
          "called_by_user_id",
          "status (pending|called|arrived|in_consultation|completed)"
        ],
        "indices": [
          "clinic_queue(clinic_id, called_at DESC)",
          "clinic_queue(status)"
        ]
      },
      "critical_points": [
        "Race condition: Usar transação com LOCK",
        "WebSocket reliability: Fallback com polling 5s",
        "Sincronização: Backend é fonte de verdade"
      ]
    },
    {
      "id": 2,
      "name": "Assinatura Digital",
      "type": "Digital Signature + External Integration",
      "duration": "30-60 segundos",
      "latency_target": "< 2s (sistema) + 30-40s (humano)",
      "critical_in": "Conformidade legal (CFM 2.299/21) e segurança",
      "actors": [
        "Frontend (médico)",
        "API (FastAPI)",
        "Backend (PDF generation)",
        "ClickSign (ICP-Brasil)",
        "WhatsApp API",
        "Database (PostgreSQL)"
      ],
      "stages": 6,
      "key_metrics": {
        "pdf_generation": "1-2s",
        "clicksign_upload": "< 2s",
        "signature_human": "30-40s",
        "webhook": "< 1s",
        "whatsapp": "< 2s",
        "total": "30-60s"
      },
      "compliance": {
        "CFM": "Resolução 2.299/21",
        "Law": "Lei 14.065/2020",
        "Certificate": "ICP-Brasil",
        "Encryption": "RSA-2048",
        "Hash": "SHA-256",
        "Timestamp": "RFC 3161"
      },
      "database": {
        "tables": [
          "prescriptions",
          "prescription_signatures"
        ],
        "fields_signatures": [
          "id",
          "prescription_id",
          "clicksign_doc_id",
          "signed_at",
          "signature_proof (JSON)",
          "status (pending|signed|failed)"
        ],
        "indices": [
          "prescription_signatures(status)",
          "prescription_signatures(prescription_id)"
        ]
      },
      "integrations": [
        "ClickSign API (sign, webhook)",
        "WhatsApp API (document delivery)",
        "ReportLab (PDF generation)",
        "QRCode library"
      ],
      "critical_points": [
        "Webhook security: Validar HMAC SHA-256",
        "QR Code validation: Link público para qualquer um",
        "CFM compliance: Não requer assinatura em papel",
        "Expiration: Se não assinar em 24h, expirar"
      ]
    },
    {
      "id": 3,
      "name": "Anamnese (Primeira Consulta)",
      "type": "Structured Data Collection + Auto-save",
      "duration": "5-20 minutos (usuário)",
      "latency_target": "< 0.5s (auto-save), < 2s (finalização)",
      "critical_in": "Completude de dados e validação",
      "actors": [
        "Frontend (paciente/médico)",
        "Backend (FastAPI)",
        "Database (PostgreSQL)",
        "ClickSign (assinatura opcional)"
      ],
      "tabs": 5,
      "stages": 6,
